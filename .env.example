# Optional. Leave blank to use demo mode without keys.
# Secret, server-only key. Restrict it to Places API (New) and your server egress IP where supported.
GOOGLE_PLACES_API_KEY=

# Separate public browser key. Restrict it to Maps JavaScript API and your website HTTP referrers.
# Never reuse the Places server key here: NEXT_PUBLIC values are included in browser bundles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map ID for Advanced Markers. The Google demo map ID is used when blank.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
